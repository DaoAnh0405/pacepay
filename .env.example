JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10

# otp cho đăng ký tài khoản / đổi mật khẩu (app password cho local)
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
BREVO_API_KEY=

