<%- include('../partials/header') %>
<h1>Quên mật khẩu</h1>

<div id="forgot-wizard">
  <section class="step" data-step="1">
    <form id="form-1">
      <label>Email<input type="email" name="email" required></label>
      <button type="submit">Tiếp tục</button>
    </form>

    <div id="account-missing" hidden>
      <p>Tài khoản không tồn tại. Bạn muốn tạo tài khoản mới?</p>
      <a href="/register">Đăng ký</a>
    </div>
  </section>

  <section class="step" data-step="2" hidden>
    <form id="form-2">
      <label>Mã xác thực gửi tới email
        <input type="text" name="otp" inputmode="numeric" maxlength="6" required>
      </label>
      <button type="submit">Xác nhận</button>
    </form>
  </section>

  <section class="step" data-step="3" hidden>
    <form id="form-3">
      <label>Mã xác thực gửi tới điện thoại
        <input type="text" name="otp" inputmode="numeric" maxlength="6" required>
      </label>
      <button type="submit">Xác nhận</button>
    </form>
  </section>

  <section class="step" data-step="4" hidden>
    <form id="form-4">
      <label>Mật khẩu mới (tối thiểu 8 ký tự) <input type="password" name="password" minlength="8" required></label>
      <label>Nhập lại mật khẩu <input type="password" name="confirm" required></label>
      <button type="submit">Đổi mật khẩu</button>
    </form>
  </section>
</div>

<p id="message" class="message"></p>
<p><a href="/login">Quay lại đăng nhập</a></p>
<%- include('../partials/footer') %>