<%- include('../partials/header') %>
<div class="auth-wrap">
  <div class="auth-card">
    <h1>Đổi mật khẩu</h1>
    <form id="password-form">
      <button type="button" id="password-send-otp" class="btn-outline">Gửi mã SMS</button>
      <p id="otp-hint" class="modal-hint"></p>

      <label>Mã SMS (6 số)
        <input type="text" name="otp" inputmode="numeric" maxlength="6" required>
      </label>
      <label>Mật khẩu hiện tại
        <input type="password" name="currentPassword" required>
      </label>
      <label>Mật khẩu mới (tối thiểu 8 ký tự)
        <input type="password" name="newPassword" minlength="8" required>
      </label>
      <label>Nhập lại mật khẩu mới
        <input type="password" name="confirm" required>
      </label>

      <p id="message" class="message"></p>
      <button type="submit" class="btn-primary">Đổi mật khẩu</button>
    </form>
    <p class="auth-foot"><a href="/profile">← Quay lại tài khoản</a></p>
  </div>
</div>
<%- include('../partials/footer') %>