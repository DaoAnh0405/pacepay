<%- include('../partials/header') %>
<h1>Đăng ký</h1>
<p id="progress">Bước 1/7</p>

<div id="register-wizard">
  <section class="step" data-step="1">
    <form id="form-1">
      <label>Email <input type="email" name="email" required></label>
      <button type="submit">Gửi mã xác thực</button>
    </form>
    <div id="email-exists" hidden>
      <p>Tài khoản đã tồn tại. Bạn muốn đăng nhập?</p>
      <a href="/login">Đăng nhập</a>
    </div>
  </section>

  <section class="step" data-step="2" hidden>
    <form id="form-2">
      <label>Mã xác thực gửi tới email (6 số)
        <input type="text" name="otp" inputmode="numeric" maxlength="6" required>
      </label>
      <button type="submit">Xác nhận</button>
      <button type="button" id="resend-email">Gửi lại mã</button>
    </form>
  </section>

  <section class="step" data-step="3" hidden>
    <form id="form-3">
      <label>Số điện thoại <input type="tel" name="phone" placeholder="0912345678" required></label>
      <button type="submit">Gửi mã SMS</button>
    </form>
  </section>

  <section class="step" data-step="4" hidden>
    <form id="form-4">
      <label>Mã xác thực gửi tới điện thoại (6 số)
        <input type="text" name="otp" inputmode="numeric" maxlength="6" required>
      </label>
      <button type="submit">Xác nhận</button>
      <button type="button" id="resend-phone">Gửi lại mã</button>
    </form>
  </section>

  <section class="step" data-step="5" hidden>
    <form id="form-5">
      <label>Mật khẩu (tối thiểu 8 ký tự) <input type="password" name="password" minlength="8" required></label>
      <label>Nhập lại mật khẩu <input type="password" name="confirm" required></label>
      <button type="submit">Tiếp tục</button>
    </form>
  </section>

  <section class="step" data-step="6" hidden>
    <form id="form-6">
      <label>Họ và tên <input type="text" name="fullName" required></label>
      <button type="submit">Tiếp tục</button>
    </form>
  </section>

  <section class="step" data-step="7" hidden>
    <form id="form-7">
      <label>Ngày sinh <input type="date" name="dateOfBirth"></label>
      <label>Địa chỉ (không bắt buộc) <input type="text" name="address" maxlength="255"></label>
      <button type="submit">Hoàn tất đăng ký</button>
    </form>
  </section>
</div>

<p id="message"></p>
<p>Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
<%- include('../partials/footer') %>