<%- include('../partials/header') %>
<div class="signup">
  <h1>Đăng ký tài khoản PacePay</h1>

  <div id="register-wizard">
    <section class="step" data-step="1">
      <form id="form-1">
        <label><span>Email của bạn <span class="text-danger">*</span> </span>
          <input type="email" name="email" required>
        </label>
        <button type="submit" class="btn-blue">Tiếp theo</button>
      </form>
      <div id="email-exists" hidden>
        <p>Tài khoản đã tồn tại. Bạn muốn đăng nhập?</p>
        <a href="/login">Đăng nhập</a>
      </div>
    </section>

    <section class="step" data-step="2" hidden>
      <form id="form-2">
        <label ><span>Mã xác thực gửi tới email</span>
          <input type="text" name="otp" inputmode="numeric" maxlength="6" required>
        </label>
        <button type="submit" class="btn-blue">Xác nhận</button>
        <button type="button" id="resend-email" class="btn-ghost">Gửi lại mã</button>
      </form>
    </section>

    <section class="step" data-step="3" hidden>
      <form id="form-3">
        <label ><span>Số điện thoại <span class="text-danger">*</span> </span>
          <input type="tel" name="phone" placeholder="0912345678" required>
        </label>
        <button type="submit" class="btn-blue">Tiếp tục</button>
      </form>
    </section>

    <section class="step" data-step="4" hidden>
      <form id="form-4">
        <label ><span>Mã xác thực gửi tới điện thoại</span>
          <input type="text" name="otp" inputmode="numeric" maxlength="6" required>
        </label>
        <button type="submit" class="btn-blue">Xác nhận</button>
        <button type="button" id="resend-phone" class="btn-ghost">Gửi lại mã</button>
      </form>
    </section>

    <section class="step" data-step="5" hidden>
      <form id="form-5">
        <label ><span>Mật khẩu (tối thiểu 8 ký tự) <span class="text-danger">*</span> </span>
          <input type="password" name="password" minlength="8" required>
        </label>
        <label ><span>Nhập lại mật khẩu <span class="text-danger">*</span> </span>
          <input type="password" name="confirm" required>
        </label>
        <button type="submit" class="btn-blue">Tiếp tục</button>
      </form>
    </section>

    <section class="step" data-step="6" hidden>
      <form id="form-6">
        <label ><span>Họ và tên <span class="text-danger">*</span> </span>
          <input type="text" name="fullName" required>
        </label>
        <button type="submit" class="btn-blue">Tiếp tục</button>
      </form>
    </section>

    <section class="step" data-step="7" hidden>
      <form id="form-7">
        <label ><span>Ngày sinh <span class="text-danger">*</span> </span>
          <input type="date" name="dateOfBirth" required>
        </label>
        <label ><span>Địa chỉ</span>
          <input type="text" name="address" maxlength="255">
        </label>
        <button type="submit" class="btn-blue">Hoàn tất đăng ký</button>
      </form>
    </section>
  </div>

  <p id="message" class="message"></p>
  <p class="signup-foot">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
</div>
<%- include('../partials/footer') %>