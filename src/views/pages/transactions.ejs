<%- include('../partials/header') %>
<h1>Lịch sử giao dịch</h1>

<form method="get" action="/transactions" class="filters">
  <label>Loại
    <select name="type">
      <option value="">Tất cả</option>
      <option value="deposit"  <%= filters.type === 'deposit'  ? 'selected' : '' %>>Nạp tiền</option>
      <option value="withdraw" <%= filters.type === 'withdraw' ? 'selected' : '' %>>Rút tiền</option>
      <option value="transfer" <%= filters.type === 'transfer' ? 'selected' : '' %>>Chuyển tiền</option>
    </select>
  </label>
  <label>Từ ngày <input type="date" name="from" value="<%= filters.from || '' %>"></label>
  <label>Đến ngày <input type="date" name="to" value="<%= filters.to || '' %>"></label>
  <button type="submit">Áp dụng</button>
</form>

<% if (result.items.length === 0) { %>
  <p>Chưa có giao dịch nào.</p>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Thời gian</th><th>Mã GD</th><th>Nội dung</th><th>Số tiền</th><th>Số dư sau</th></tr>
      </thead>
      <tbody>
        <% result.items.forEach((t) => { %>
          <tr>
            <td><%= new Date(t.created_at).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }) %></td>
            <td><%= t.reference_code %></td>
            <td>
              <%= describe(t) %>
              <% if (t.note) { %><br><small><%= t.note %></small><% } %>
            </td>
            <td class="<%= t.direction === 'out' ? 'amt-out' : 'amt-in' %>">
              <%= t.direction === 'out' ? '-' : '+' %><%= formatVND(t.amount) %>
            </td>
            <td><%= formatVND(t.balance_after) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <p>
    <% if (result.page > 1) { %><a href="/transactions?<%= qs(result.page - 1) %>" class=""><button class="btn btn-blue">← Trước</button></a><% } %>
    Trang <%= result.page %>/<%= result.totalPages %> (<%= result.total %> giao dịch)
    <% if (result.page < result.totalPages) { %><a href="/transactions?<%= qs(result.page + 1) %>"><button class="btn btn-blue">Sau →</button></a><% } %>
  </p>
<% } %>
<%- include('../partials/footer') %>